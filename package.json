{
  "name": "secure-vault-extension",
  "version": "1.0.0",
  "private": true,
  "description": "A local-only, encrypted password manager Chrome extension (Manifest V3) built with Next.js, React, TypeScript and Tailwind CSS.",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/build-extension.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.300",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.23.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "~5.5.4",
    "vitest": "^2.0.5"
  }
}
